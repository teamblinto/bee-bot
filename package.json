{
  "name": "@beebot/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "dev:desktop": "node scripts/dev-runner.ts",
    "prepare:cua": "node scripts/prepare-cua-driver.ts",
    "start:desktop": "vp run --filter @beebot/desktop start",
    "build": "vp run --filter \"./apps/*\" --filter ./apps/boxd/egress build",
    "typecheck": "vp run -r --cache --concurrency-limit 4 typecheck",
    "lint": "vp lint --report-unused-disable-directives",
    "test": "vp run -r test",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "dist:desktop:win": "vp run build && vp run --filter @beebot/desktop dist:win",
    "dist:desktop:mac": "vp run build && vp run --filter @beebot/desktop dist:mac",
    "dist:desktop:linux": "vp run build && vp run --filter @beebot/desktop dist:linux",
    "release:linux": "vp run build && node scripts/release-linux.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "jsdom": "26.1.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "26.13.0"
  },
  "packageManager": "pnpm@12.16.1"
}
