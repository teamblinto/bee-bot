[Unit]
Description=Bee Bot cell %i
# Its only listener is the socket systemd makes (beebotd@.socket); stopping that stops the cell.
Requires=beebot-fence.service beebotd@%i.socket
After=network-online.target beebot-fence.service beebotd@%i.socket
Wants=network-online.target

[Service]
Type=simple
User=%i
Group=%i
Slice=beebot-%i.slice
WorkingDirectory=/var/lib/beebot/cells/%i
EnvironmentFile=/etc/beebot/beebot.env
Environment=BEEBOT_SERVER_MODE=1
Environment=BEEBOT_DATA_DIR=/var/lib/beebot/cells/%i/data
Environment=BEEBOT_BOX_ROOT=/opt/beebot/current
Environment=XDG_RUNTIME_DIR=/run/beebot/run/%i
Environment=CONTAINERS_CONF_OVERRIDE=/etc/beebot/containers.conf
EnvironmentFile=/etc/beebot/box-image.env
LoadCredentialEncrypted=vault-key:/etc/beebot/creds/%i.vault-key.cred
RuntimeDirectory=beebot/run/%i
RuntimeDirectoryMode=0700
# Fails closed: no fence, no cell.
ExecStartPre=+/usr/sbin/nft list chain inet beebot_fence cell
# Each cell holds the box image in its own store: rootless Podman re-owns an image's files into a
# box's id range, which it cannot do for layers in a root-owned shared store.
ExecStartPre=/bin/sh -c 'podman image exists "$BEEBOT_BOX_IMAGE" || exec podman load -q -i /var/lib/beebot/box-image.tar'
ExecStart=/usr/bin/node /opt/beebot/current/apps/server/dist/index.cjs
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=78 79
TimeoutStartSec=5min
TimeoutStopSec=30

# Rootless Podman makes its container cgroups inside ours, so the slice's limits cover the boxes.
Delegate=yes
DelegateSubgroup=supervisor

UMask=0077
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/beebot/cells/%i
# On the host only root can enter /var/lib/beebot/cells, so this is the cell's one way to its home,
# and no cell sees another's. File modes can't do it: Podman gives everyone --x on every folder
# above a box's root filesystem, and any cell can become "everyone" through its subordinate ids.
TemporaryFileSystem=/var/lib/beebot/cells:mode=0755
BindPaths=/var/lib/beebot/cells/%i
ProtectHome=yes
RemoveIPC=yes
# Not set, because rootless Podman needs what they take away: NoNewPrivileges= stops the setuid
# newuidmap/newgidmap that map a box's ids, and every seccomp-based option (RestrictSUIDSGID=,
# SystemCallFilter=, ProtectKernelModules=, ProtectClock=, LockPersonality=, RestrictNamespaces=,
# RestrictAddressFamilies=, ...) implies it for a non-root service. ProtectKernelTunables= makes
# /proc/sys read-only, and crun writes a box's own sysctls there. ProtectControlGroups= would take
# the delegated cgroup back. PrivateDevices= hides /dev/net/tun; CapabilityBoundingSet= would cap
# Podman inside its own user namespace.

[Install]
WantedBy=multi-user.target
