# Bee Bot behind Caddy, as deploy/install.sh writes it. Caddy terminates TLS and hands every
# request, WebSockets included, to the gateway's unix socket. Caddy reaches it through the
# beebot-web group; never add Caddy to beebot-gw, which opens every cell's socket.
# With admin off there is no admin API to reload through: restart Caddy to apply a change.
{
	admin off
}

bee.example.com {
	reverse_proxy unix//run/beebot/gateway/gateway.sock
}
