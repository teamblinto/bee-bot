FROM docker.io/library/debian:trixie-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2

# Engine: tmux, git, and what the vendor installers need (bash, curl, CA roots). Node and npm
# run local MCP servers (`npx ...`) in a connector's own box.
# Computer: an Xfce desktop on Xvfb (window manager, panels, desktop icons, terminal, file
# manager, app finder) with headed Chromium, dbus and portals for file pickers, a VNC server,
# xdotool and ImageMagick for input and screenshots, and socat for boxd to reach loopback-only
# DevTools and the VNC socket via podman exec.
RUN apt-get update \
 && apt-get install -y --no-install-recommends bash ca-certificates curl git tmux nodejs npm \
      chromium fonts-noto-core socat \
      xvfb dbus-x11 xdg-desktop-portal xdg-desktop-portal-gtk x11vnc xdotool imagemagick \
      xfwm4 xfce4-panel xfdesktop4 xfce4-settings xfconf xfce4-terminal thunar xfce4-appfinder \
      exo-utils x11-utils elementary-xfce-icon-theme \
 && rm -rf /var/lib/apt/lists/* \
 && useradd -u 10001 -U -m -d /home/bee -s /bin/bash bee \
 && install -d -o 10001 -g 10001 /work /browser /downloads

COPY --chmod=0755 engine.sh /usr/local/bin/bee-engine
COPY --chmod=0755 browser.sh /usr/local/bin/bee-browser
COPY tmux.conf /etc/bee/tmux.conf
COPY xfce/ /etc/xdg/xfce4/
COPY chromium.flags /etc/chromium.d/bee
COPY chromium-policy.json /etc/chromium/policies/managed/bee.json

# Server mode's box-image.sh names the Claude Code that claude-code.sha256 pins; the desktop's
# build leaves it out. The binary is the one the vendor's installer downloads, checked against the
# hash this repo pins rather than a manifest from the same bucket, and copied out unchanged.
ARG CLAUDE_CODE_VERSION=
COPY claude-code.sha256 /tmp/pin/
RUN if [ -n "$CLAUDE_CODE_VERSION" ]; then \
      cd /tmp/pin \
      && curl -fsSLo "claude-$CLAUDE_CODE_VERSION-linux-x64" \
        "https://downloads.claude.ai/claude-code-releases/$CLAUDE_CODE_VERSION/linux-x64/claude" \
      && sha256sum -c claude-code.sha256 \
      && install -m 0755 "claude-$CLAUDE_CODE_VERSION-linux-x64" /usr/local/bin/claude; \
    fi \
 && rm -rf /tmp/pin

# /home/bee is the persistent volume the vendor installers write into (~/.local/bin).
ENV HOME=/home/bee \
    PATH=/home/bee/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

USER 10001:10001
WORKDIR /work
CMD ["bee-engine"]
