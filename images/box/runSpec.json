{
  "image": "localhost/beebot-box:3",
  "user": "10001:10001",
  "engine": {
    "command": ["bee-engine"],
    "init": true,
    "capDrop": "all",
    "securityOpt": ["no-new-privileges"],
    "readOnly": true,
    "tmpfs": ["/tmp:rw,size=256m,mode=1777"],
    "shmSize": "64m",
    "memory": "2g",
    "memorySwap": "2g",
    "cpus": 2,
    "pidsLimit": 512,
    "volumes": { "home": "/home/bee", "workspace": "/work" },
    "tmuxSession": "main"
  },
  "browser": {
    "command": ["bee-browser"],
    "init": true,
    "capDrop": "all",
    "securityOpt": ["no-new-privileges"],
    "seccompProfile": "images/box/seccomp-chromium.json",
    "readOnly": true,
    "tmpfs": ["/tmp:rw,size=256m,mode=1777", "/downloads:rw,size=256m,mode=1777"],
    "shmSize": "1g",
    "memory": "1g",
    "memorySwap": "1g",
    "cpus": 2,
    "pidsLimit": 512,
    "hostname": "bee-browser",
    "volumes": { "profile": "/browser" },
    "downloadsDir": "/downloads"
  }
}
